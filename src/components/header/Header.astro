<header id="main-header" class="header-container">
  <div class="header-content bg-brand">
    <div class="logo-wrapper">
      <a href="/" aria-label="Inicio" title="Dra. Pamela J. Fernandez">
        <img
          src="/logo.svg"
          alt="Dra. Pamela J. Fernandez - Cirujana General y Bariátrica"
          class="h-8 w-auto"
          width="180"
          height="40"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    </div>

    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="/#home">Inicio</a>
      <a href="/#sobre-mi">Sobre mí</a>
      <a href="/centros">Centros</a>
      <a href="/#tratamientos">Tratamientos</a>
      <a
        href="#contact"
        class="inline-flex items-center gap-3 bg-brand-4 text-white font-bold text-lg px-4 py-1 rounded-full transition-all duration-300 hover:scale-[1.04] hover:shadow-xl hover:bg-brand-5 focus:outline-none focus:ring-2 focus:ring-brand-4 active:scale-105 shadow-lg"
        >Contacto</a
      >
    </nav>

    <button
      id="menu-btn"
      class="menu-toggle"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="bar bg-brand-5"></span>
      <span class="bar bg-brand-5"></span>
      <span class="bar bg-brand-5"></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu bg-brand">
    <nav class="text-brand-5">
      <a href="/#home">Inicio</a>
      <a href="/#sobre-mi">Sobre mí</a>
      <a href="/centros">Centros</a>
      <a href="/#tratamientos">Tratamientos</a>
      <a href="#contact" class="mobile-contact">Contacto</a>
    </nav>
  </div>
</header>

<style>
  /* Tu CSS original se mantiene intacto */
  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: transform 0.4s ease-in-out;
    will-change: transform; /* OPTIMIZACIÓN: Avisamos al navegador que esto va a cambiar */
  }
  .header-content {
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo-img {
    height: 2rem;
    width: auto;
  }
  .desktop-nav {
    display: none;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
    .header-content {
      padding: 1rem 5rem;
    }
  }
  .desktop-nav a {
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.875rem;
    transition: transform 0.3s;
  }
  .desktop-nav a:hover {
    transform: scale(1.1);
  }
  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    z-index: 1100;
  }
  @media (min-width: 768px) {
    .menu-toggle {
      display: none;
    }
  }
  .bar {
    width: 25px;
    height: 2px;
    border-radius: 2px;
    transition: all 0.3s;
  }
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 80px;
    transform: translateX(100%);
    transition: transform 0.3s ease-in-out;
    z-index: 1050;
    pointer-events: none;
  }
  .mobile-menu.active {
    transform: translateX(0);
    pointer-events: auto;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }
  .mobile-menu a {
    padding: 1.5rem 2rem;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
  }
  .menu-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const initHeader = () => {
    const header = document.getElementById("main-header");
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!header || !menuBtn || !mobileMenu) return;

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;
    let ticking = false; // Control de frames

    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      menuBtn.classList.toggle("active", isMenuOpen);
      mobileMenu.classList.toggle("active", isMenuOpen);
      document.body.style.overflow = isMenuOpen ? "hidden" : "";
      if (isMenuOpen) header.style.transform = "translateY(0)";
    };

    menuBtn.onclick = toggleMenu;

    const links = mobileMenu.querySelectorAll("a");
    links.forEach((l) => {
      (l as HTMLElement).onclick = () => {
        if (isMenuOpen) toggleMenu();
      };
    });

    const updateHeader = () => {
      const currentScrollY = window.scrollY;

      if (!isMenuOpen) {
        if (currentScrollY > lastScrollY && currentScrollY > 80) {
          header.style.transform = "translateY(-100%)";
        } else {
          header.style.transform = "translateY(0)";
        }
      }
      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        // Optimizamos con requestAnimationFrame para evitar el reflow forzado
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );
  };

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
