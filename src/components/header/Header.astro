---
import { CONTACT } from "../../consts";

const links = [
  { href: "/#home", label: "Inicio" },
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/centros", label: "Centros" },
  { href: "/#tratamientos", label: "Tratamientos" },
  { href: "/#preguntas-frecuentes", label: "Preguntas" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header id="main-header" class="header-container">
  <div class="header-content">
    <div class="logo-wrapper">
      <a href="/" aria-label="Inicio" title="Dra. Pamela J. Fernandez">
        <img
          src="/logo.svg"
          alt="Dra. Pamela J. Fernandez - Cirujana General y Bariátrica"
          class="h-8 w-auto"
          width="180"
          height="40"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    </div>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.href.startsWith("/#")
                ? undefined
                : link.href === current
                  ? "page"
                  : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        class="inline-flex items-center gap-3 bg-brand-4 text-white font-bold text-base px-5 py-2 rounded-full transition-all duration-300 hover:scale-[1.04] hover:shadow-xl hover:bg-brand-5 active:scale-105 shadow-lg"
        >Turnos</a
      >
    </nav>

    <button
      id="menu-btn"
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="bar bg-brand-5"></span>
      <span class="bar bg-brand-5"></span>
      <span class="bar bg-brand-5"></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu bg-brand" inert>
    <nav class="text-brand-5" aria-label="Navegación principal (móvil)">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={`tel:${CONTACT.phone}`} data-track-label="menu-movil-telefono">
        Llamar
      </a>
      <a href="/#contact" class="mobile-contact">Pedir turno</a>
    </nav>
  </div>
</header>

<style>
  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition:
      transform 0.4s ease-in-out,
      box-shadow 0.3s ease;
    will-change: transform;
    background-color: var(--color-brand);
  }
  /* Sombra sutil sólo cuando el contenido pasa por debajo del header. */
  .header-container.is-scrolled {
    box-shadow: 0 6px 24px -18px rgba(83, 60, 39, 0.9);
  }
  .header-content {
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .desktop-nav {
    display: none;
    gap: 1.75rem;
    align-items: center;
  }
  /* El nav tiene 6 items: por debajo de 1000px no entran y se solapan con el
     logo, así que el menú hamburguesa se mantiene hasta ese ancho. */
  @media (min-width: 1000px) {
    .desktop-nav {
      display: flex;
    }
    .header-content {
      padding: 1rem 3rem;
    }
  }
  @media (min-width: 1280px) {
    .header-content {
      padding: 1rem 5rem;
    }
  }
  .desktop-nav a {
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.875rem;
    transition: transform 0.3s;
  }
  .desktop-nav a:hover {
    transform: scale(1.1);
  }
  .desktop-nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    z-index: 1100;
  }
  @media (min-width: 1000px) {
    .menu-toggle {
      display: none;
    }
  }
  .bar {
    width: 25px;
    height: 2px;
    border-radius: 2px;
    transition: all 0.3s;
  }
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-top: 80px;
    transform: translateX(100%);
    transition: transform 0.3s ease-in-out;
    z-index: 1050;
    pointer-events: none;
  }
  .mobile-menu.active {
    transform: translateX(0);
    pointer-events: auto;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }
  .mobile-menu a {
    padding: 1.25rem 2rem;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
  }
  .mobile-menu .mobile-contact {
    margin: 1.5rem 2rem;
    padding: 1rem 2rem;
    text-align: center;
    border-radius: 9999px;
    background-color: var(--color-brand-4);
    color: #fff;
  }
  .menu-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>

<script>
  const header = document.getElementById("main-header");
  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (header && menuBtn && mobileMenu) {
    let isMenuOpen = false;
    let lastScrollY = window.scrollY;
    let ticking = false;

    const setMenu = (open: boolean) => {
      isMenuOpen = open;
      menuBtn.classList.toggle("active", open);
      mobileMenu.classList.toggle("active", open);
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      // `inert` saca del orden de tabulación y del árbol de accesibilidad todo
      // el menú cuando está cerrado: sin esto se podía tabular a links ocultos.
      mobileMenu.toggleAttribute("inert", !open);
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        header.style.transform = "translateY(0)";
        mobileMenu.querySelector<HTMLElement>("a")?.focus();
      }
    };

    menuBtn.addEventListener("click", () => setMenu(!isMenuOpen));

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (isMenuOpen) setMenu(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isMenuOpen) {
        setMenu(false);
        menuBtn.focus();
      }
    });

    // Si se pasa a viewport de escritorio con el menú abierto, el overflow
    // hidden del body quedaba trabado.
    window.matchMedia("(min-width: 1000px)").addEventListener("change", (e) => {
      if (e.matches && isMenuOpen) setMenu(false);
    });

    const updateHeader = () => {
      const currentScrollY = window.scrollY;
      header.classList.toggle("is-scrolled", currentScrollY > 8);

      if (!isMenuOpen) {
        header.style.transform =
          currentScrollY > lastScrollY && currentScrollY > 80
            ? "translateY(-100%)"
            : "translateY(0)";
      }
      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );

    updateHeader();
  }
</script>
