---
import CallButton from "../CallButton.astro";
import { OFFICE, waLink } from "../../consts";
---

<section
  id="contact"
  class="relative py-24 md:py-32 bg-gradient-to-b from-brand-4 to-brand-5 overflow-hidden"
>
  <div
    class="max-w-4xl mx-auto px-6 text-center flex flex-col gap-6 relative z-10"
  >
    <h2
      data-aos="fade-up"
      class="font-extrabold text-3xl md:text-4xl lg:text-5xl text-brand"
    >
      Agendá tu consulta hoy
    </h2>

    <p
      data-aos="fade-up"
      data-aos-delay="100"
      class="text-brand/90 text-lg md:text-xl max-w-2xl mx-auto"
    >
      Consultas personalizadas, evaluación médica completa y acompañamiento
      integral en todo tu proceso quirúrgico.
    </p>

    <div
      data-aos="fade-up"
      data-aos-delay="200"
      class="flex flex-col sm:flex-row gap-4 justify-center mt-4"
    >
      <a
        href={waLink("sección contacto")}
        target="_blank"
        rel="noopener noreferrer"
        title="Agendar turno por WhatsApp con la Dra. Pamela J. Fernandez"
        aria-label="Solicitar un turno médico vía WhatsApp"
        data-track-label="contacto-whatsapp"
        class="inline-flex items-center justify-center gap-3
          bg-[#25D366] text-white
          font-extrabold text-lg
          py-4 px-10 rounded-full
          transition-all duration-300
          hover:scale-105 hover:bg-[#128C7E] shadow-[0_10px_30px_-10px_rgba(37,211,102,0.5)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
          <path
            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
          ></path>
        </svg>
        WhatsApp
      </a>

      <CallButton variant="dark" trackLabel="contacto-telefono" />
    </div>

    {/* Datos de contacto en texto plano: los buscadores los leen y los usuarios
        los pueden copiar sin depender de un botón. */}
    <address
      data-aos="fade-up"
      data-aos-delay="300"
      class="not-italic text-brand/80 text-sm mt-4 flex flex-col gap-1"
    >
      <span>{OFFICE.street}, {OFFICE.locality}, {OFFICE.region}</span>
      <span>{OFFICE.hoursDisplay}</span>
      <a
        href={OFFICE.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:text-brand transition-colors"
      >
        Ver cómo llegar
      </a>
    </address>
  </div>
</section>
