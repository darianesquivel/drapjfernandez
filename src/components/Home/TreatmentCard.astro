---
interface Props {
  number: string;
  title: string;
  description: string;
  href: string;
}

const { number, title, description, href } = Astro.props;
---

<a
  href={href}
  title={`Saber más sobre ${title}`}
  aria-label={`Ver información detallada sobre ${title}`}
  class="group relative block rounded-3xl p-8 md:p-10 bg-brand
         transition-all duration-300 hover:-translate-y-2 hover:shadow-xl"
>
  <span
    aria-hidden="true"
    class="absolute top-3 right-3 text-6xl font-extrabold select-none text-brand-2"
  >
    {number}
  </span>

  <h3 class="text-2xl md:text-3xl font-extrabold mb-4 text-brand-5">
    {title}
  </h3>

  <p class="leading-relaxed max-w-md text-brand-5/80">
    {description}
  </p>

  <div
    class="mt-6 text-sm font-semibold tracking-wide flex items-center gap-1 text-brand-4"
  >
    Ver más <span
      class="transition-transform duration-300 group-hover:translate-x-1"
      aria-hidden="true">→</span
    >
  </div>
</a>
