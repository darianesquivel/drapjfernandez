---
const { title, description, href } = Astro.props;
---

<a
  href={href}
  class="group relative block h-full
         rounded-3xl bg-brand
         p-8
         border border-brand-5/10
         transition-all duration-300
         hover:-translate-y-1 hover:shadow-2xl"
>
  <!-- detalle decorativo -->
  <!-- <div
    class="absolute top-0 right-0 w-24 h-24
           bg-brand-3/10 rounded-bl-3xl"
  >
  </div> -->

  <div class="relative z-10">
    <h3
      class="text-2xl font-bold text-brand-5 mb-4
             group-hover:text-brand-3 transition-colors"
    >
      {title}
    </h3>

    <p class="text-brand-5/70 leading-relaxed mb-6">
      {description}
    </p>

    <span
      class="inline-flex items-center gap-2
             text-sm font-semibold text-brand-3"
    >
      Ver más
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </span>
  </div>
</a>
