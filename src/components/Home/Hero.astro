      class="flex flex-col text-center [@media(min-width:1000px)]:text-left order-2 [@media(min-width:1000px)]:order-1"
    >
      <span
        class="inline-block self-center [@media(min-width:1000px)]:self-start mb-4 px-4 py-1 rounded-full
