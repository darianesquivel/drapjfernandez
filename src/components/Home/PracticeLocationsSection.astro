---
import { OFFICES, waLink } from "../../consts";
---

<section
  id="sedes"
  class="relative bg-gradient-to-b from-brand-5 to-brand-4 py-20 lg:py-28 overflow-hidden"
>
  <img
    src="/wave2.svg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none"
    width="1920"
    height="1080"
  />

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
      <div class="flex flex-col" data-aos="fade-right">
        <div class="text-center md:px-10 px-0 mb-8">
          <h2 class="font-extrabold text-3xl md:text-4xl text-white mb-4">
            Dónde atiendo
          </h2>
          <p class="text-white/90 text-lg max-w-sm mx-auto">
            Atención clínica y seguimiento pre y post quirúrgico, en consultorio
            privado y en hospital público.
          </p>
        </div>

        <div class="flex-1 flex flex-col gap-6">
          {
            OFFICES.map((office) => (
              <div class="bg-white/10 backdrop-blur-sm p-6 rounded-3xl border border-white/10 flex flex-col gap-3">
                <p class="text-[10px] uppercase tracking-widest text-brand font-bold">
                  {office.kind}
                </p>
                <h3 class="text-white font-bold text-lg leading-snug">
                  {office.name}
                </h3>
                <p class="text-white/90 text-sm">
                  {office.street}, {office.locality}
                </p>
                <p class="text-brand/90 text-sm font-semibold">
                  {office.hoursDisplay}
                </p>
                <a
                  href={office.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="self-start text-xs uppercase font-bold tracking-wide text-white/80 underline underline-offset-4 hover:text-white transition-colors"
                >
                  Ver en Google Maps
                </a>
              </div>
            ))
          }

          <div class="text-center mt-2">
            <a
              href={waLink("sección dónde atiendo")}
              target="_blank"
              rel="noopener noreferrer"
              title="Agendar consulta por WhatsApp"
              aria-label="Agendar consulta por WhatsApp"
              data-track-label="sedes-whatsapp"
              class="inline-block bg-brand text-brand-5 font-bold py-4 px-12 rounded-full transition-all duration-300 hover:bg-brand-2 hover:scale-105 shadow-lg w-full sm:w-auto"
            >
              Agendar consulta
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col" data-aos="fade-left">
        <div class="text-center md:px-10 px-0 mb-8">
          <h2 class="font-extrabold text-3xl md:text-4xl text-white mb-4">
            Dónde opero
          </h2>
          <p class="text-white/90 text-lg max-w-sm mx-auto">
            Instituciones de alta complejidad donde realizo mis cirugías.
          </p>
        </div>

        <div class="flex-1 flex flex-col gap-6">
          <div
            class="bg-white/10 backdrop-blur-sm p-8 rounded-3xl flex flex-col items-center justify-center gap-6 border border-white/10 flex-1"
          >
            <div class="hover:scale-105 transition-all duration-300">
              <img
                src="/laslomas-logo.svg"
                alt="Sanatorio Las Lomas"
                class="h-20 md:h-24 object-contain w-auto"
                loading="lazy"
                decoding="async"
                width="200"
                height="96"
              />
            </div>
            <div class="space-y-1 text-center">
              <p class="text-xs uppercase tracking-widest text-brand font-bold">
                Sedes habilitadas
              </p>
              <p class="text-white/90 font-medium italic">
                San Isidro · Nordelta · Hills · Ángelus
              </p>
            </div>
          </div>

          <div class="text-center mt-2">
            <a
              href="/centros"
              class="inline-block bg-brand text-brand-5 font-bold py-4 px-12 rounded-full transition-all duration-300 hover:bg-brand-2 hover:scale-105 shadow-lg w-full sm:w-auto"
            >
              Ver detalle de sedes
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
