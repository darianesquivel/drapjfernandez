<header
  id="header"
  class="bg-transparent fixed top-0 left-0 right-0 z-50 font-bold py-4"
>
  <nav
    class="container mx-auto px-6 py-2 flex justify-between items-center relative"
  >
    <a href="/#" class="flex items-center relative z-20">
      <img
        src="/logo.svg"
        alt="Dra. Fernandez logo"
        class="h-8 md:h-8 w-auto"
      />
      <span class="sr-only">Dra. Fernandez - Volver a Inicio</span>
    </a>

    <div
      id="main-nav"
      class="hidden lg:flex bg-white p-2 rounded-full relative"
    >
      <div
        id="pill-indicator"
        class="absolute top-0 bottom-0 left-0 bg-brand rounded-full transition-all duration-300 ease-in-out"
      >
      </div>

      <div class="flex space-x-0 relative z-10">
        <a
          href="/#"
          data-section="inicio"
          class="nav-link text-white bg-brand-blue text-sm px-4 py-1 rounded-full whitespace-nowrap"
          >Inicio</a
        >
        <a
          href="/#about-me"
          data-section="sobre-mi"
          class="nav-link text-brand-gray-dark hover:text-white hover:bg-transparent text-sm px-4 py-1 rounded-full whitespace-nowrap"
          >Sobre mi</a
        >
        <a
          href="/#locations"
          data-section="centros"
          class="nav-link text-brand-gray-dark hover:text-white hover:bg-transparent text-sm px-4 py-1 rounded-full whitespace-nowrap"
          >Centros</a
        >
        <a
          href="/#bariatrica"
          data-section="bariatrica"
          class="nav-link text-brand-gray-dark hover:text-white hover:bg-transparent text-sm px-4 py-1 rounded-full whitespace-nowrap"
          >Cirugía Bariátrica</a
        >
        <a
          href="/#general"
          data-section="general"
          class="nav-link text-brand-gray-dark hover:text-white hover:bg-transparent text-sm px-4 py-1 rounded-full whitespace-nowrap"
          >Cirugía General</a
        >
      </div>
    </div>

    <div class="flex items-center space-x-4 relative z-20">
      <a
        href="/Contact"
        class="hidden md:block bg-cta text-white font-bold py-1 px-4 rounded-full hover:bg-brand-blue-dark transition-transform duration-300 hover:scale-105 shadow-lg"
      >
        Contacto
      </a>

      <button
        id="menu-btn"
        class="text-brand-gray-dark focus:outline-none lg:hidden bg-white p-2 rounded-lg shadow-md"
        aria-label="Abrir menú principal"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 bg-white shadow-xl mx-6 rounded-xl mt-2"
  >
    <a
      href="/#"
      class="block py-3 px-6 text-sm text-brand-gray-dark hover:bg-brand-gray-light font-normal"
      >Inicio</a
    >
    <a
      href="/#about-me"
      class="block py-3 px-6 text-sm text-brand-gray-dark hover:bg-brand-gray-light font-normal"
      >Sobre mi</a
    >
    <a
      href="/#locations"
      class="block py-3 px-6 text-sm text-brand-gray-dark hover:bg-brand-gray-light font-normal"
      >Centros</a
    >
    <a
      href="/#bariatrica"
      class="block py-3 px-6 text-sm text-brand-gray-dark hover:bg-brand-gray-light font-normal"
      >Cirugía Bariátrica</a
    >
    <a
      href="/#general"
      class="block py-3 px-6 text-sm text-brand-gray-dark hover:bg-brand-gray-light font-normal"
      >Cirugía General</a
    >
    <div class="p-4 border-t border-brand-gray-light">
      <a
        href="/Contact"
        class="w-full text-center block bg-cta text-white font-bold p-2 rounded-full transition-all duration-300 hover:bg-brand-blue-dark shadow-lg"
      >
        Contacto
      </a>
    </div>
  </div>
</header>

<script>
  // 1. Lógica del Menú Móvil (Mantenemos la que ya tenías)
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  function toggleMobileMenu() {
    const isExpanded = menu?.classList.contains("max-h-0");

    if (isExpanded) {
      menu?.classList.remove("max-h-0", "opacity-0");
      menu?.classList.add("max-h-screen", "opacity-100");
      btn?.setAttribute("aria-expanded", "true");
      btn?.setAttribute("aria-label", "Cerrar menú principal");
    } else {
      menu?.classList.remove("max-h-screen", "opacity-100");
      menu?.classList.add("max-h-0", "opacity-0");
      btn?.setAttribute("aria-expanded", "false");
      btn?.setAttribute("aria-label", "Abrir menú principal");
    }
  }

  btn?.addEventListener("click", toggleMobileMenu);

  const mobileLinks = document.querySelectorAll("#mobile-menu a");
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      // Cierra el menú móvil al hacer click en un enlace
      if (window.innerWidth < 1024) {
        // Solo si es móvil (lg breakpoint)
        toggleMobileMenu();
      }
    });
  });

  // 2. Lógica del Pill Animado (NUEVA)
  const navLinks = document.querySelectorAll("#main-nav .nav-link");
  const pillIndicator = document.getElementById("pill-indicator");
  const mainNavContainer = document.getElementById("main-nav");

  function updatePill(activeLink) {
    if (!activeLink || !pillIndicator || !mainNavContainer) return;

    // 1. Calcular la posición y tamaño del enlace activo
    const containerRect = mainNavContainer.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();

    // 2. Aplicar las transformaciones al indicador
    pillIndicator.style.width = `${linkRect.width}px`;
    // La posición Left es el desplazamiento del link menos el padding del contenedor
    pillIndicator.style.transform = `translateX(${linkRect.left - containerRect.left}px)`;

    // 3. Ajustar el color del texto de los enlaces
    navLinks.forEach((link) => {
      link.classList.remove("text-white", "bg-brand-blue");
      link.classList.add("text-brand-gray-dark");
    });
    activeLink.classList.add("text-white", "bg-brand-blue");
    activeLink.classList.remove("text-brand-gray-dark");
  }

  // Identifica el enlace activo al cargar la página (ejemplo simple con hash)
  function initializePill() {
    let currentHash = window.location.hash || "#";
    let activeLink = null;

    // Busca el enlace que coincide con la URL actual o el hash, o usa el primero ("Inicio")
    activeLink =
      Array.from(navLinks).find(
        (link) => link.getAttribute("href") === currentHash
      ) || navLinks[0];

    // Mueve el pill al enlace inicial
    updatePill(activeLink);
  }

  // Mover el pill al hacer click
  navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      // Previenes la navegación temporalmente para que la animación se vea
      // e.preventDefault();
      updatePill(e.currentTarget);

      // La navegación real ocurre después de la animación si es necesario,
      // o se deja que el link haga la navegación normal.
      // Aquí, dejamos la navegación normal para evitar JS complejo de routing.
    });
  });

  // Re-ajustar al cambiar el tamaño de la ventana
  window.addEventListener("resize", () => {
    initializePill();
  });

  // Inicializar al cargar el DOM
  document.addEventListener("DOMContentLoaded", initializePill);
</script>
