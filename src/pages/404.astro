---
import Layout from "../layouts/Layout.astro";
import { waLink } from "../consts";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/cirugia-bariatrica", label: "Cirugía bariátrica" },
  { href: "/cirugia-general", label: "Cirugía general" },
  { href: "/cirugia-percutanea", label: "Cirugía percutánea" },
  { href: "/centros", label: "Centros" },
];
---

<Layout
  title="Página no encontrada | Dra. Pamela J. Fernandez"
  description="La página que buscás no existe o cambió de dirección."
  noindex
>
  <section
    class="min-h-[70vh] flex items-center justify-center bg-brand px-6 pt-32 pb-20"
  >
    <div class="max-w-xl text-center flex flex-col gap-6">
      <p class="text-7xl font-extrabold text-brand-2">404</p>
      <h1 class="text-3xl md:text-4xl font-extrabold text-brand-5">
        No encontramos esta página
      </h1>
      <p class="text-brand-5/80 text-lg">
        Puede que el enlace haya cambiado. Probá con alguna de estas secciones o
        escribinos directamente.
      </p>

      <nav class="flex flex-wrap justify-center gap-3" aria-label="Secciones">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="bg-brand-2 text-brand-5 font-bold text-sm px-5 py-2 rounded-full transition-colors hover:bg-brand-4 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div>
        <a
          href={waLink("página 404")}
          target="_blank"
          rel="noopener noreferrer"
          data-track-label="404-whatsapp"
          class="inline-block bg-brand-4 text-white font-bold py-3 px-8 rounded-full transition-all duration-300 hover:bg-brand-5 hover:scale-105 shadow-lg"
        >
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
