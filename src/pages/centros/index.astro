---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const locations = [
  {
    name: "Sanatorio Las Lomas SI (Sede Central)",
    address: "Av. Diego Carman 555, San Isidro, Buenos Aires",
    mapEmbedSrc:
      "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3286.745672224724!2d-58.5539423237748!3d-34.53671755562137!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcbb8603ed6127%3A0xb355d91113b83870!2sAv.%20Diego%20Carman%20555%2C%20San%20Isidro%2C%20Provincia%20de%20Buenos%20Aires!5e0!3m2!1ses-419!2sar!4v1750000000000!5m2!1ses-419!2sar",
    details: "Sede principal con Internación, Quirófanos y Guardia.",
  },
  {
    name: "Sanatorio Las Lomas Nordelta",
    address: "Av. de los Lagos 6785, Tigre, Buenos Aires",
    mapEmbedSrc:
      "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3291.687445903964!2d-58.65780522379377!3d-34.41018265147551!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bda47d2a57173d%3A0x7d27e2a9b3a62858!2sSanatorio%20Las%20Lomas%20Nordelta!5e0!3m2!1ses-419!2sar!4v1750000000001!5m2!1ses-419!2sar",
    details: "Consultorios externos y Guardia de baja complejidad.",
  },
  {
    name: "Clínica Ángelus",
    address: "Av Fondo de la Legua 390, San Isidro",
    mapEmbedSrc:
      "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3286.745672224724!2d-58.5539423237748!3d-34.53671755562137!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcbb8603ed6127%3A0xb355d91113b83870!2sAv.%20Diego%20Carman%20555%2C%20San%20Isidro%2C%20Provincia%20de%20Buenos%20Aires!5e0!3m2!1ses-419!2sar!4v1750000000006!5m2!1ses-419!2sar", // Placeholder, usar el correcto
    details: "Consultorios y prácticas médicas en zona norte.",
  },
];
---

<Layout title="Centros - Dra. Fernandez">
  <section
    id="locations"
    class="py-20 md:py-28 bg-gradient-to-b from-brand-1 to-brand-2"
  >
    <div class="max-w-6xl mx-auto px-6">
      <header class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-5 mb-4">
          Lugares de Atención
        </h2>
        <p class="max-w-2xl mx-auto text-lg text-brand-4">
          Centros médicos donde realizo procedimientos quirúrgicos.
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        {
          locations.map((loc, index) => (
            <article
              data-aos="fade-up"
              data-aos-delay={100 + index * 100}
              class="flex flex-col bg-white/80 backdrop-blur
                   border border-black/5
                   rounded-2xl overflow-hidden
                   transition-all duration-300
                   hover:shadow-xl"
            >
              {/* mapa */}
              <div class="h-56 w-full">
                <iframe
                  title={`Mapa de ${loc.name}`}
                  src={loc.mapEmbedSrc}
                  class="w-full h-full"
                  style="border:0;"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>

              {/* info */}
              <div class="p-6 flex flex-col gap-3">
                <h3 class="text-xl font-bold text-brand-blue-dark leading-tight">
                  {loc.name}
                </h3>

                <p class="text-sm text-gray-600">{loc.address}</p>

                <p class="text-sm text-gray-500 italic">{loc.details}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
