---

<Layout title="Centros - Dra. Fernandez">
  <section id="locations" class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6">
      <h2
        class="text-4xl md:text-5xl font-extrabold text-center text-brand-blue mb-4"
      >
        Lugares de Atención
      </h2>
      <p class="text-center text-gray-600 max-w-3xl mx-auto mb-12">
        La Dra. atiende en las siguientes instituciones. Consulta tu centro más
        cercano.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
        {
          locations.map((loc, index) => (
            <div
              data-aos="fade-up"
              data-aos-delay={100 + index * 100}
              class="bg-brand-gray-light rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden"
            >
              <div class="p-6 text-center">
                <h3 class="text-xl font-bold text-brand-blue-dark mb-2">
                  {loc.name}
                </h3>
                <p class="text-brand-gray-dark mb-4">{loc.address}</p>
                <p class="text-sm italic text-gray-500">{loc.details}</p>
              </div>

              {loc.mapEmbedSrc ? (
                <div class="w-full h-64 md:h-80">
                  <iframe
                    title={`Mapa de ${loc.name}`}
                    class="w-full h-full"
                    src={loc.mapEmbedSrc}
                    style="border:0;"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  />
                </div>
              ) : (
                <div class="w-full h-64 md:h-80 bg-red-100 flex items-center justify-center p-4">
                  <p class="text-center text-red-700 font-semibold">
                    🔴 {loc.address}
                  </p>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
