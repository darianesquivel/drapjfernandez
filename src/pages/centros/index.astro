---

<Layout
  title="Centros donde opera y atiende | Dra. Pamela J. Fernandez"
  description="Sanatorio Las Lomas (San Isidro, Nordelta, Hills), Clínica Ángelus, IMAC, Clínica del Sol y Sanatorio Finochietto: dónde atiende y opera la Dra. Fernandez."
  breadcrumbs={[
    { name: "Inicio", path: "/" },
    { name: "Centros", path: "/centros/" },
  ]}
>
  <section
    id="locations"
    class="py-20 lg:py-28 bg-gradient-to-b from-brand-1 to-brand-2"
  >
    <div class="max-w-6xl py-10 mx-auto px-6 flex flex-col gap-10">
      <header class="text-center flex flex-col gap-4">
        <h1
          data-aos="fade-up"
          class="text-4xl md:text-5xl font-extrabold text-brand-5"
        >
          Centros donde atiendo y opero
        </h1>
        <p
          data-aos="fade-up"
          data-aos-delay="100"
          class="max-w-2xl mx-auto text-lg text-brand-4"
        >
          Centros médicos de alta complejidad donde la Dra. Pamela J. Fernandez
          realiza sus procedimientos quirúrgicos.
        </p>
      </header>

      <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-12"
      >
        {
          locations.map((loc) => (
            <article
              data-aos="fade-up"
              data-aos-delay="200"
              class="flex flex-col bg-white/80 backdrop-blur
                   border border-black/5
                   rounded-2xl overflow-hidden
                   transition-all duration-300
                   hover:shadow-xl"
            >
              <MapEmbed
                src={loc.mapEmbedSrc}
                name={loc.name}
                address={loc.address}
              />

              <div class="p-6 flex flex-col gap-3">
                <h3 class="text-xl font-bold text-brand-5 leading-tight">
                  {loc.name}
                </h3>
                <p class="text-sm text-brand-5/80 font-medium">{loc.address}</p>
                <p class="text-sm text-brand-5/60 italic leading-relaxed">
                  {loc.details}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="max-w-6xl py-10 mx-auto px-6 flex flex-col gap-10">
      <header class="text-center flex flex-col gap-4">
        <h2
          data-aos="fade-up"
          class="text-2xl md:text-3xl font-extrabold text-brand-5"
        >
          Otros centros de atención con mi equipo
        </h2>
      </header>
      <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-12"
      >
        {
          locationsV2.map((loc) => (
            <article
              data-aos="fade-up"
              data-aos-delay="200"
              class="flex flex-col bg-white/80 backdrop-blur
                   border border-black/5
                   rounded-2xl overflow-hidden
                   transition-all duration-300
                   hover:shadow-xl"
            >
              <MapEmbed
                src={loc.mapEmbedSrc}
                name={loc.name}
                address={loc.address}
              />

              <div class="p-6 flex flex-col gap-3">
                <h3 class="text-xl font-bold text-brand-5 leading-tight">
                  {loc.name}
                </h3>
                <p class="text-sm text-brand-5/80 font-medium">{loc.address}</p>
                <p class="text-sm text-brand-5/60 italic leading-relaxed">
                  {loc.details}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <PageCta
    source="centros"
    title="¿Querés coordinar tu consulta?"
    text="Escribinos y te indicamos el centro más conveniente según tu cobertura y tu zona."
  />
</Layout>
