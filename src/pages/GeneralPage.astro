---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="General - Dra. Fernandez">
  <section id="/GeneralPage" class="h-dvh -mt-15 pt-15">
    <div class="flex flex-col items-center justify-center">
      <h3 class="text-2xl font-bold">Cirugia General</h3>
      <p class="text-lg">
        La cirugía general es un procedimiento que ayuda a las personas a
        recuperarse de una cirugía o de una enfermedad.
      </p>
    </div>
  </section>
</Layout>
