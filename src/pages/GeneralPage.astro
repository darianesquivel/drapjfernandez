---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="General - Dra. Fernandez">
  <section id="cirugia-general" class="py-24 md:py-36 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-bold text-xl text-brand-5 tracking-wide mb-3">
          Cirugía General
        </p>
        <h2
          class="font-extrabold text-3xl md:text-4xl lg:text-5xl text-gray-900 mb-6"
        >
          Atención Integral en <span class="text-brand-5">Cirugía General</span>
        </h2>
        <p class="text-lg md:text-xl text-gray-700 max-w-3xl mx-auto">
          Procedimientos quirúrgicos de alta complejidad realizados con
          precisión, experiencia y el más alto estándar de calidad médica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Card 1: Colecistectomía -->
        <div
          class="bg-gray-50 rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-48 bg-gradient-to-br from-brand-5 to-teal-600 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-24 w-24 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-xl text-gray-900 mb-3">
              Colecistectomía
            </h3>
            <p class="text-gray-700 text-sm leading-relaxed">
              Extracción de la vesícula biliar por laparoscopía. Recuperación
              rápida y mínimamente invasiva para cálculos biliares.
            </p>
          </div>
        </div>

        <!-- Card 2: Hernias -->
        <div
          class="bg-gray-50 rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-48 bg-gradient-to-br from-brand-2 to-blue-500 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-24 w-24 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-xl text-gray-900 mb-3">
              Reparación de Hernias
            </h3>
            <p class="text-gray-700 text-sm leading-relaxed">
              Tratamiento de hernias inguinales, umbilicales e incisionales con
              técnicas avanzadas y malla de refuerzo.
            </p>
          </div>
        </div>

        <!-- Card 3: Apendicectomía -->
        <div
          class="bg-gray-50 rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-48 bg-gradient-to-br from-teal-500 to-brand-5 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-24 w-24 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-xl text-gray-900 mb-3">Apendicectomía</h3>
            <p class="text-gray-700 text-sm leading-relaxed">
              Cirugía de urgencia para extracción del apéndice inflamado.
              Procedimiento laparoscópico con recuperación óptima.
            </p>
          </div>
        </div>

        <!-- Card 4: Cirugía de Tiroides -->
        <div
          class="bg-gray-50 rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-48 bg-gradient-to-br from-brand-2 to-brand-5 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-24 w-24 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-xl text-gray-900 mb-3">
              Cirugía de Tiroides
            </h3>
            <p class="text-gray-700 text-sm leading-relaxed">
              Tiroidectomía parcial o total para tratamiento de nódulos, bocio o
              cáncer de tiroides con técnica precisa.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
