---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Bariatrica - Dra. Fernandez">
  <section id="bariatrica" class="py-24 md:py-36 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <p class="font-bold text-xl text-brand-5 tracking-wide mb-3">
          Cirugía Bariátrica
        </p>
        <h2
          class="font-extrabold text-3xl md:text-4xl lg:text-5xl text-gray-900 mb-6"
        >
          Procedimientos que <span class="text-brand-5">Transforman Vidas</span>
        </h2>
        <p class="text-lg md:text-xl text-gray-700 max-w-3xl mx-auto">
          Técnicas quirúrgicas avanzadas para el tratamiento de la obesidad,
          diseñadas para ayudarte a alcanzar tus objetivos de salud de forma
          segura y sostenible.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1: Manga Gástrica -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-56 bg-gradient-to-br from-brand-2 to-brand-5 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-32 w-32 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-2xl text-gray-900 mb-4">
              Manga Gástrica
            </h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Procedimiento que reduce el tamaño del estómago en un 80%,
              limitando la cantidad de alimentos y generando saciedad temprana.
              Ideal para pacientes con obesidad severa.
            </p>
            <div class="flex items-center text-brand-5 font-semibold">
              <span class="mr-2">Más información</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Card 2: Bypass Gástrico -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-56 bg-gradient-to-br from-brand-5 to-brand-2 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-32 w-32 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-2xl text-gray-900 mb-4">
              Bypass Gástrico
            </h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Técnica que reduce el estómago y modifica el intestino para
              limitar absorción de nutrientes. Excelentes resultados en pérdida
              de peso y control de diabetes tipo 2.
            </p>
            <div class="flex items-center text-brand-5 font-semibold">
              <span class="mr-2">Más información</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Card 3: Balón Intragástrico -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2"
        >
          <div
            class="h-56 bg-gradient-to-br from-brand-2 to-brand-5 flex items-center justify-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-32 w-32 text-white opacity-90"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"
              ></path>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-bold text-2xl text-gray-900 mb-4">
              Balón Intragástrico
            </h3>
            <p class="text-gray-700 leading-relaxed mb-4">
              Procedimiento no quirúrgico donde se coloca un balón en el
              estómago para generar saciedad. Opción temporal y efectiva para
              iniciar el proceso de pérdida de peso.
            </p>
            <div class="flex items-center text-brand-5 font-semibold">
              <span class="mr-2">Más información</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
