---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import "aos/dist/aos.css";
import "../styles/global.css";
import WhatsappBtn from "../components/WhatsappBtn.astro";

const {
  title = "Dra. Pamela J. Fernandez - Cirujana Gral.",
  description = "Especialista en cirugía bariátrica, general y percutánea.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.drapjfernandez.com.ar" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.drapjfernandez.com.ar" />
    <meta
      property="og:image"
      content="https://www.drapjfernandez.com.ar/og-image.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://www.drapjfernandez.com.ar/og-image.png"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://unpkg.com" />
    <link
      rel="preload"
      as="image"
      href="/hero-image.svg"
      fetchpriority="high"
    />
    <link
      rel="modulepreload"
      href="/_astro/Layout.astro_ast.DLx97c9h.js"
      as="script"
      crossorigin
    />
  </head>

  <body class="bg-brand antialiased text-brand-5">
    <Header />
    <main class="flex flex-col min-h-screen">
      <slot />
    </main>
    <Footer />
    <WhatsappBtn />

    <script>
      import AOS from "aos";

      function initAOS() {
        AOS.init({
          duration: 800,
          offset: 50,
          once: true,
          easing: "ease-in-out",
        });
      }

      if (window.requestIdleCallback) {
        window.requestIdleCallback(() => initAOS());
      } else {
        setTimeout(initAOS, 100);
      }

      document.addEventListener("astro:after-swap", initAOS);
    </script>
  </body>
</html>
