---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";

const {
  title = "Dra. Pamela J. Fernandez - Cirujana Gral.",
  description = "Especialista en cirugía bariátrica, general y percutánea. Brindando soluciones integrales para mejorar tu salud y calidad de vida.",
} = Astro.props;

import "../styles/global.css";
import WhatsappBtn from "../components/WhatsappBtn.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.drapjfernandez.com.ar" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Dra. Pamela Fernandez, cirugía bariátrica, cirujana general, cirugía percutánea, manga gástrica, bypass gástrico, medicina UBA, cirugía mínimamente invasiva, tratamiento obesidad, salud metabólica, radiología intervencionista, cirugía San Isidro, cirugía Nordelta, cirujana bariátrica Argentina, recuperación rápida cirugía, atención médica integral, cirugía metabólica, pérdida de peso quirúrgica"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.drapjfernandez.com.ar" />
    <meta
      property="og:image"
      content="https://www.drapjfernandez.com.ar/og-image.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://www.drapjfernandez.com.ar/og-image.png"
    />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
  </head>

  <body class="bg-brand antialiased text-brand-5">
    <Header />
    <main class="flex flex-col min-h-screen"><slot /></main>
    <Footer />
    <WhatsappBtn />
    <script is:inline src="https://unpkg.com/aos@2.3.4/dist/aos.js" defer
    ></script>
    <script is:inline type="module">
      AOS?.init({
        duration: 800,
        offset: 50,
        once: true,
        easing: "ease-in-out",
      });
    </script>
  </body>
</html>
