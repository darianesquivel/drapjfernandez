# Dominio canonico: www -> sin www, redireccion 301 permanente.
# Sin esto Hostinger sirve las dos versiones del sitio con 200 y Google las
# trata como contenido duplicado, repartiendo la autoridad entre ambas.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.drafernandez\.com\.ar$ [NC]
RewriteRule ^(.*)$ https://drafernandez.com.ar/$1 [R=301,L]

# Cache larga para assets con hash en el nombre (Astro los versiona, asi que
# cambiar el contenido cambia la URL y no hace falta revalidar).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
